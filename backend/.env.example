NODE_ENV=development
PORT=3000

# Comma-separated frontend origins allowed by CORS (exact match).
# Dev mode also allows private LAN origins (192.168/10/172.16) automatically.
# With the Angular /api proxy, browsers rarely need cross-origin CORS in local dev.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# MySQL — match Workbench / your smartcampus user
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=smartcampus
DB_PASSWORD=your-mysql-password-here
DB_DATABASE=smart_campus

# Set true in local dev / first cloud boot to create tables; then false in production
DB_SYNC=true

# Hosted MySQL/TiDB: leave unset (TLS on). Local Workbench: omit or DB_SSL=false
DB_SSL=

JWT_SECRET=smartcampus-demo-secret
JWT_EXPIRES_IN=1d

# Public frontend URL for teacher QR (phones open this HTTPS site, not a LAN IP)
PUBLIC_APP_URL=

# Gemini Live English voice. Create a free key at
# https://aistudio.google.com/apikey — never commit the real value.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
